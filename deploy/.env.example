# ============================================================
# 闹钟 Agent 生产环境变量模板
# 用法：复制本文件为同目录 .env，填入真实值后启动
#   cp .env.example .env
#   docker compose up -d --build
# 切勿将 .env 提交到 git（已被 .gitignore / .dockerignore 排除）
# ============================================================

# 【必填】API Key 静态加密主密钥，≥32 位随机串。
# 生成方式（任选其一）：
#   openssl rand -hex 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 重要：必须在「首次启动前」设置；之后切勿更改，否则已加密的密钥无法解密。
ALARM_MASTER_KEY=请替换为至少32位随机十六进制串

# 服务监听端口（容器内固定 8080，由 Caddy 反向代理对外）
PORT=8080

# —— 可选：LLM 长尾兜底（规则引擎置信度不足时调用）——
# ALARM_LLM_KEY=sk-xxxxxxxx
# ALARM_LLM_BASE_URL=https://api.openai.com/v1
# ALARM_LLM_MODEL=gpt-4o-mini
